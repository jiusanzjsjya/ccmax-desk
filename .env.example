APP_ENV=development
APP_URL=http://localhost:3000

# Generate a real value before exposing the service.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Superadmin bootstrap. The superadmin signs in on the login page with this
# account name + password (there is no access-key login anymore). All backend
# config below is only seeded from env on first run — afterwards it is edited
# in the superadmin console and the persisted store is the source of truth.
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=replace-with-a-strong-superadmin-password

# --- The values below are SEED DEFAULTS only (editable in the console). ---

# Sub2API Admin API. Keep the token server-side; never expose it to the browser.
# Sub2API always brokers the Claude OAuth handshake, so this is required even
# when the destination backend below is not Sub2API.
SUB2API_BASE_URL=http://localhost:8080
SUB2API_ADMIN_TOKEN=
SUB2API_PROXY_ID=

# Default target account pool that receives the finished Claude account.
# One of: sub2api | newapi | oneapi | custom (default: sub2api).
BACKEND_KIND=sub2api

# new-api (only needed when BACKEND_KIND=newapi). ADMIN_TOKEN authenticates the
# admin API (Authorization: Bearer) to create channels. NEWAPI_USER_ID feeds the
# optional New-Api-User header (unused by recent forks; harmless when set).
# CHANNEL_TYPE 14 = Anthropic. IMPORTANT: new-api's Anthropic channel accepts ONLY
# a static Anthropic API key (sk-ant-...) in NEWAPI_ANTHROPIC_API_KEY — a Claude
# OAuth token cannot be stored there. Without the key, this backend is not usable.
NEWAPI_BASE_URL=
NEWAPI_ADMIN_TOKEN=
NEWAPI_USER_ID=
NEWAPI_CHANNEL_TYPE=14
NEWAPI_MODELS=claude-3-5-sonnet-latest
NEWAPI_ANTHROPIC_API_KEY=

# one-api (only needed when BACKEND_KIND=oneapi). Same as new-api: ADMIN_TOKEN for
# the admin API, and a static Anthropic API key (sk-ant-...) for the channel key.
ONEAPI_BASE_URL=
ONEAPI_ADMIN_TOKEN=
ONEAPI_CHANNEL_TYPE=14
ONEAPI_MODELS=claude-3-5-sonnet-latest
ONEAPI_ANTHROPIC_API_KEY=

# Self-built gateway (only needed when BACKEND_KIND=custom). Receives a
# Sub2API-shaped account payload at CUSTOM_BACKEND_URL; list is optional.
CUSTOM_BACKEND_URL=
CUSTOM_BACKEND_TOKEN=
CUSTOM_BACKEND_LIST_URL=

# Local RBAC account store. Keep this path outside the public repository.
LOCAL_ACCOUNT_STORE_PATH=.data/accounts.json

# Optional policy settings.
PROVISIONING_SESSION_TTL_SECONDS=1800
