APP_ENV=development
APP_URL=http://localhost:3000

# Generate a real value before exposing the service.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Local admin gate for this provisioning bridge.
ADMIN_ACCESS_KEY=replace-with-a-long-random-admin-key

# Sub2API Admin API. Keep the token server-side; never expose it to the browser.
SUB2API_BASE_URL=http://localhost:8080
SUB2API_ADMIN_TOKEN=
SUB2API_PROXY_ID=

# Local RBAC account store. Keep this path outside the public repository.
LOCAL_ACCOUNT_STORE_PATH=.data/accounts.json

# Optional policy settings.
PROVISIONING_SESSION_TTL_SECONDS=1800
